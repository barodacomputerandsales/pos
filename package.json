{
    "name": "bcs-enterprise-pos",
    "version": "2.3.5",
    "description": "BCS Enterprise POS PRO Max",
    "author": "BCS Developer",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "start:login": "electron . --login",
        "build": "electron-builder --win",
        "build:win": "electron-builder --win",
        "release": "electron-builder --win --publish always"
    },
    "dependencies": {
        "acorn": "^8.19.0",
        "electron-updater": "^6.8.9"
    },
    "devDependencies": {
        "electron": "^31.3.1",
        "electron-builder": "^26.15.3"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/barodacomputerandsales/pos"
    },
    "build": {
        "appId": "com.bcsdeveloper.pos",
        "productName": "BCS Enterprise POS PRO Max",
        "copyright": "Copyright © 2026 BCS Developer. All rights reserved.",
        "directories": {
            "output": "dist",
            "buildResources": "assets"
        },
        "files": [
            "**/*",
            "!backend/**",
            "!*.md",
            "!.github/**"
        ],
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "icon": "assets/icon.ico",
            "legalTrademarks": "BCS Enterprise POS is engineered by BCS Developer (https://www.bcsdeveloper.com)",
            "requestedExecutionLevel": "asInvoker",
            "verifyUpdateCodeSignature": false
        },
        "nsis": {
            "oneClick": true,
            "perMachine": false,
            "allowToChangeInstallationDirectory": false,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "BCS Enterprise POS",
            "uninstallDisplayName": "BCS Enterprise POS",
            "runAfterFinish": true,
            "differentialPackage": false,
            "deleteAppDataOnUninstall": false
        },
        "publish": [
            {
                "provider": "github",
                "owner": "barodacomputerandsales",
                "repo": "pos",
                "releaseType": "release"
            }
        ]
    }
}
